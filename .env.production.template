# ========================================
# NAPA VALLEY WINERIES - PRODUCTION ENV
# ========================================
# Use this template for Vercel deployment
# Copy these variables to Vercel Dashboard

# ========================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ========================================
MONGODB_URI=mongodb+srv://napa-admin:<PASSWORD>@napa-wineries-prod.xxxxx.mongodb.net/nvw?retryWrites=true&w=majority
NEXT_PUBLIC_MONGO_URI=mongodb+srv://napa-admin:<PASSWORD>@napa-wineries-prod.xxxxx.mongodb.net/nvw?retryWrites=true&w=majority

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# Generate random 32+ character string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-minimum

# ========================================
# APPLICATION URL (Vercel will provide)
# ========================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Option 1: Ethereal (Testing - FREE)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your-ethereal-user
EMAIL_PASS=your-ethereal-pass

# Option 2: SendGrid (Production - FREE 100/day)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key
EMAIL_FROM=info@napawineries.com

# ========================================
# SMS CONFIGURATION (Optional - Twilio)
# ========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_ENABLE_SMS=false

# ========================================
# STRIPE PAYMENT PROCESSING
# ========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_or_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your_stripe_publishable_key

# ========================================
# GOOGLE MAPS API (Optional)
# ========================================
# Get from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ========================================
# GEMINI AI API (Optional - for Voice Search)
# ========================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ========================================
# CLOUDINARY (Optional - for image uploads)
# ========================================
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========================================
# FIREBASE (Optional - for advanced features)
# ========================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
