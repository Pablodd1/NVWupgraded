# ========================================
# NAPA VALLEY WINERIES - SECURE PRODUCTION ENV
# ========================================
# SECURITY CHECKLIST:
# ✅ Never commit this file with real values
# ✅ Use strong, unique passwords (32+ characters)
# ✅ Rotate secrets regularly
# ✅ Use different credentials for dev/staging/production
# ========================================

# ========================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ========================================
# REQUIRED: Production database connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appname>

# ========================================
# AUTHENTICATION & SECURITY (CRITICAL)
# ========================================
# REQUIRED: Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use NEXT_PUBLIC_ prefix for secrets!
JWT_SECRET=

# Optional: Session expiry (default: 7d)
JWT_EXPIRES_IN=7d

# ========================================
# APPLICATION URL
# ========================================
# REQUIRED: Your production domain
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ========================================
# EMAIL CONFIGURATION (REQUIRED)
# ========================================
# Option 1: SendGrid (Recommended - FREE 100 emails/day)
# Sign up: https://sendgrid.com/
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@your-domain.com

# Option 2: Gmail (Requires App Password)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=your-email@gmail.com

# Option 3: AWS SES (Enterprise)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=noreply@your-domain.com

# Legacy support (will be deprecated)
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=

# ========================================
# SMS NOTIFICATIONS (OPTIONAL)
# ========================================
# Twilio: https://www.twilio.com/ (Free $15 credit)
NEXT_PUBLIC_ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# PAYMENT PROCESSING (STRIPE)
# ========================================
# REQUIRED for payments: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_or_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_
STRIPE_WEBHOOK_SECRET=whsec_

# ========================================
# GOOGLE SERVICES (OPTIONAL)
# ========================================
# Google Maps API: https://console.cloud.google.com/
# Restrict API key to your domain in Google Console!
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Gemini AI (for voice search): https://makersuite.google.com/
GEMINI_API_KEY=

# ========================================
# CLOUDINARY (OPTIONAL - Image Uploads)
# ========================================
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================================
# SECURITY CONFIGURATION
# ========================================
# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# ========================================
# MONITORING & LOGGING (OPTIONAL)
# ========================================
# Sentry for error tracking: https://sentry.io/
SENTRY_DSN=

# LogRocket for session replay: https://logrocket.com/
LOGROCKET_APP_ID=

# ========================================
# FEATURE FLAGS
# ========================================
NEXT_PUBLIC_ENABLE_VOICE_SEARCH=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production
