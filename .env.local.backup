JWT_SECRET=napa-valley-wineries-super-secret-jwt-key-2025-secure-random-string-12345

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Using Ethereal Email for testing (free, no setup required)
# Emails will be captured at https://ethereal.email/
MAILTRAP_HOST=smtp.ethereal.email
MAILTRAP_PORT=587
MAILTRAP_USER=auto-generated@ethereal.email
MAILTRAP_PASS=auto-generated-password
EMAIL_FROM=notifications@napawineries.com

# ========================================
# SMS CONFIGURATION (Optional - Twilio)
# ========================================
# Sign up at https://www.twilio.com/ for real SMS
# Leave blank to disable SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_ENABLE_SMS=false

# ========================================
# STRIPE PAYMENT PROCESSING (Test Mode)
