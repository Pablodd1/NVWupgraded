# 🍷 NAPA VALLEY WINERIES - PRODUCTION ENV TEMPLATE

# 🍃 DATABASE (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nvw_production

# 🔑 AUTHENTICATION
JWT_SECRET=generate_a_random_long_string_here_for_security
# Use this for local development if needed, Vercel will use the auto-assigned URL or your custom domain
NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app

# 💳 PAYMENTS (Stripe)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# 📧 EMAIL (Mailtrap or SMTP)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_user
MAILTRAP_PASS=your_pass
EMAIL_FROM=notifications@yourdomain.com

# 📱 SMS (Twilio)
NEXT_PUBLIC_ENABLE_SMS=false
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890

# 🛠️ FEATURE FLAGS
NEXT_PUBLIC_ENABLE_VOICE_SEARCH=true
