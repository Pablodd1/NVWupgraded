# 🍷 NAPA VALLEY WINERIES - PRODUCTION ENV TEMPLATE
# Copy this to .env.local on your server (Hostinger)

# 🍃 DATABASE (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nvw_production

# 🔑 AUTHENTICATION
JWT_SECRET=generate_a_random_long_string_here_for_security

# 💳 PAYMENTS (Stripe)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# 📧 EMAIL (Resend recommended)
RESEND_API_KEY=re_...
EMAIL_FROM=notifications@yourdomain.com

# 🌐 APPLICATION
NEXT_PUBLIC_APP_URL=https://your-domain-on-hostinger.com

# 🛠️ FEATURE FLAGS
NEXT_PUBLIC_ENABLE_SMS=false
NEXT_PUBLIC_ENABLE_VOICE_SEARCH=true
