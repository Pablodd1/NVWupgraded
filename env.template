# ========================================
# DATABASE CONFIGURATION
# ========================================
# For local MongoDB on VPS
MONGODB_URI=mongodb://localhost:27017/nvw
NEXT_PUBLIC_MONGO_URI=mongodb://localhost:27017/nvw

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# Generate a strong random secret (at least 32 characters)
# You can generate one at: https://randomkeygen.com/
JWT_SECRET=your-super-secret-jwt-key-change-this-to-something-very-secure

# ========================================
# EMAIL CONFIGURATION (Resend / SMTP)
# ========================================
# Resend is the primary provider for transactional emails
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=notifications@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Optional SMTP fallback:
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ========================================
# STRIPE PAYMENT PROCESSING
# ========================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ========================================
# IMAGE UPLOAD (ImgBB CDN)
# ========================================
# Get from: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key

# ========================================
# AI CONCIERGE & SEARCH (Google Gemini)
# ========================================
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# ========================================
# GOOGLE MAPS API
# ========================================
# Get from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ========================================
# FIREBASE CONFIGURATION (Optional)
# ========================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project-name.iam.gserviceaccount.com

# ========================================
# APPLICATION URL
# ========================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ========================================
# NOTES
# ========================================
# 1. Copy this file to .env.local for local development
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env.local to Git
# 4. In Vercel, set these in Project Settings -> Environment Variables

